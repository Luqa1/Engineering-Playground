{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=structured_logging;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "textFormatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact",
          "labels": [
            {
              "key": "service_name",
              "value": "structured-logging-api"
            }
          ],
          "handleLogLevelAsLabel": true,
          "queueLimit": 10000,
          "retryTimeLimit": "00:01:00"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
